{
  "name": "roblox-stats",
  "version": "0.2.0",
  "private": true,
  "description": "Personal dashboard for tracking the most popular genres and trends on Roblox.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "live": "node --disable-warning=ExperimentalWarning server/index.js --live",
    "collect": "node --disable-warning=ExperimentalWarning server/cli/collect.js",
    "track": "node --disable-warning=ExperimentalWarning server/cli/track.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "engines": {
    "node": ">=22.13"
  }
}
